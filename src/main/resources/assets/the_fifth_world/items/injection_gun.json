{
  "model": {
    "type": "minecraft:select",

    "property": "the_fifth_world:vial_state",
    "fallback": {
      "type": "minecraft:model",
      "model": "the_fifth_world:item/injection_gun_empty"
    },
    "cases": [
      {
        "when": "empty",
        "model": {
          "type": "minecraft:model",
          "model": "the_fifth_world:item/injection_gun_vial_empty"
        }
      },
      {
        "when": "blood",
        "model": {
          "type": "minecraft:model",
          "model": "the_fifth_world:item/injection_gun_vial_blood"
        }
      }
    ]
  }
}